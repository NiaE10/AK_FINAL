/* =======================================================
   AQUAKIDS - TEMA GLOBAL (REFACTORIZADO)
   Estructura limpia y organizada por secciones.
   ======================================================= */

/* -------------------------------------------------------
   1. BASE Y CONTENEDORES PRINCIPALES
   ------------------------------------------------------- */
* {
    font-family: "Segoe UI", "Verdana", sans-serif;
    color: #333;
    outline: none;
}

QMainWindow, #central_widget, #central_area, QScrollArea, #scroll_content {
    background-color: #F4F6F9;
}

/* -------------------------------------------------------
   2. BARRA DE NAVEGACIÓN (Superior)
   ------------------------------------------------------- */
#nav_bar {
    background-color: #307EA4;
    border-bottom: 4px solid #235a75;
    padding: 8px 10px;
}
#nav_bar QLabel#logo {
    font-size: 24px;
    font-weight: 900;
    color: white;
    padding-right: 20px;
}
#nav_bar QPushButton {
    color: #E0F7FA;
    background-color: transparent;
    border: none;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 4px;
    margin: 0 4px;
}
#nav_bar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    color: white;
}
#nav_bar QPushButton[current="true"] {
    background-color: white;
    color: #307EA4;
    font-weight: bold;
    border-bottom: 3px solid #1a4d66;
}

/* -------------------------------------------------------
   3. CONTENEDORES, TARJETAS Y GRUPOS
   ------------------------------------------------------- */
#center_area, #form_container, QGroupBox, #central_widget_registro {
    background-color: white;
    border: 1px solid #dce1e6;
    border-radius: 12px;
    border-bottom: 4px solid #dce1e6;
}

/* Títulos */
QLabel#title_label, QLabel#inicio_title {
    color: #307EA4;
    font-size: 26px;
    font-weight: 900;
    margin-bottom: 20px;
}

/* Estilo de QGroupBox (Cajas de formulario) */
QGroupBox {
    margin-top: 30px;
    padding-top: 25px;
    padding-bottom: 20px;
    font-weight: 800;
    color: #307EA4;
    font-size: 16px;
    border: 1px solid #dce1e6;
    border-radius: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    left: 15px;
    background-color: white;
}
QGroupBox QLabel {
    color: #546E7A; /* Gris azulado oscuro */
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 2px;
}

/* -------------------------------------------------------
   4. FORMULARIOS (Inputs, Fechas, Combos)
   ------------------------------------------------------- */
QLineEdit, QDateEdit, QSpinBox, QTextEdit, QComboBox {
    background-color: #F0F4F8;
    color: #2c3e50;
    border: 2px solid transparent;
    border-bottom: 2px solid #b0bec5; /* Gris medio */
    border-radius: 6px 6px 0 0;
    padding: 8px 12px;
    font-size: 14px;
    min-height: 28px;
}

/* Hover suave */
QLineEdit:hover, QDateEdit:hover, QSpinBox:hover, QComboBox:hover {
    background-color: #eaf2f6;
    border-bottom: 2px solid #8FB9D0; /* Azul pastel suave */
}

/* Focus (Activo) */
QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QComboBox:focus, QComboBox:on {
    background-color: #ffffff;
    border: 2px solid #307EA4; /* Azul marca */
    border-radius: 6px;
}

/* --- Personalización del ComboBox (Eliminando el "punto") --- */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: none;
    border-top-right-radius: 6px;
    background-color: #D1E8F5;
}
QComboBox::down-arrow {
    image: none;
    border: none;  /* Esto elimina cualquier triángulo o punto */
    background: transparent;
}
QComboBox::down-arrow:on {
    border: none;
}

/* -------------------------------------------------------
   5. TABLAS (DISEÑO COMPACTO Y LIMPIO)
   ------------------------------------------------------- */
/* -------------------------------------------------------
   5. TABLAS (DISEÑO LIMPIO Y COMPACTO)
   ------------------------------------------------------- */

QTableWidget {
    background-color: white;
    alternate-background-color: #F9FAFB;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    gridline-color: transparent; /* Quita las rayas de excel */
    
    /* Letra más pequeña (12px) para que quepan más datos sin cortarse */
    font-size: 12px; 
    outline: none;
}

/* Encabezados Superiores (Títulos) */
QHeaderView::section {
    background-color: #307EA4;
    color: white;
    padding: 8px 4px;
    border: none;
    border-right: 1px solid #266d8f;
    font-weight: bold;
    font-size: 12px;
    text-transform: uppercase;
}

/* Encabezados Laterales (Números de fila) */
/* ESTO ARREGLA QUE SE VEAN RECORTADOS */
QHeaderView::section:vertical {
    background-color: #eceff1;
    color: #546E7A;
    border: none;
    border-right: 1px solid #cfd8dc;
    
    /* Espacio suficiente a los lados del número */
    padding-left: 4px;
    padding-right: 4px;
    
    font-size: 11px;
}

/* Celdas */
QTableWidget::item {
    padding: 6px;       /* Un poco más de aire */
    border-bottom: 1px solid #f0f0f0;
    color: #37474f;
}

/* Efectos */
QTableWidget::item:hover {
    background-color: #E1F5FE;
    color: black;
}
QTableWidget::item:selected {
    background-color: #D1E8F5;
    color: #0d47a1;
    font-weight: 600;
}

/* -------------------------------------------------------
   6. BOTONES DE ACCIÓN (AQUÍ ESTÁ LO QUE BUSCAS)
   ------------------------------------------------------- */

/* 6.1 Efectos Comunes (Hover y Click) para TODOS los botones */
#btn_registrar:hover, #guardar_btn:hover, #btn_guardar:hover,
#btn_editar_alumno:hover, #btn_clase_extra:hover {
    background-color: #3b8ab0; /* Azul un poco más claro */
}

/* 6.2 Botones "Grandes" (Guardar, Registrar) */
#btn_registrar, #guardar_btn, #btn_guardar {
    background-color: #307EA4;
    color: white;
    border: none;
    font-size: 16px;
    font-weight: 800;
    padding: 12px 50px;
    border-radius: 24px;
    border-bottom: 4px solid #1c526e;
}
#btn_registrar:pressed, #guardar_btn:pressed, #btn_guardar:pressed {
    background-color: #1c526e;
    border-bottom: none;
    margin-top: 4px;
}

/* ============================================================
   ⬇⬇⬇ AQUÍ ESTÁN TUS BOTONES DE PANEL LATERAL ⬇⬇⬇
   ============================================================ */
/* Botones "Editar Alumno" y "Clase Extra" */
/* AHORA USAN LA MISMA TÉCNICA EXACTA QUE EL BOTÓN GUARDAR */
#btn_editar_alumno, #btn_clase_extra {
    background-color: #307EA4;
    color: white;
    
    /* 1. Limpiamos bordes (Igual que en Guardar) */
    border: none; 
    
    /* 2. Efecto 3D inferior (Igual que en Guardar) */
    border-bottom: 4px solid #1c526e; 
    
    /* 3. Redondeado FUERTE */
    border-radius: 20px; /* Un poco menos que el de Guardar (24px) por ser más chicos, pero muy notorio */

    /* Tamaño y letra */
    font-size: 14px;
    font-weight: 800;
    
    /* Padding: Suficiente altura para que se vea la curva */
    padding: 10px 20px; 
    
    margin-top: 15px;
}

/* Comportamiento al hacer CLIC (Hundimiento) */
#btn_editar_alumno:pressed, #btn_clase_extra:pressed {
    background-color: #1c526e;
    
    border-bottom: none; /* Quitamos el borde para que "baje" */
    
    /* Ajustamos el margen para compensar la falta de borde */
    margin-top: 19px; /* 15px original + 4px que medía el borde */
}

/* Comportamiento al hacer CLIC en estos botones específicos */
#btn_editar_alumno:pressed, #btn_clase_extra:pressed {
    /* Mantenemos el color oscuro abajo para que no parpadee raro */
    border-bottom-color: #1c526e;
    
    /* Engrosamos arriba y quitamos abajo para simular movimiento */
    border-top-width: 8px;        
    border-bottom-width: 0px; 
    
    margin-top: 19px; /* 15px original + 4px de hundimiento */
}
#nav_bar {
    background-color: #307EA4;
    border-bottom: 4px solid #235a75;
    /* Aumentamos un poco el padding vertical (antes era 8px 10px) */
    padding: 10px 15px; 
}